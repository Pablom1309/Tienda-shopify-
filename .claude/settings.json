{
  "permissions": {
    "allow": [
      "Bash(python3 herramientas/*)",
      "Bash(.claude/skills/impeccable/scripts/impeccable *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git checkout*)",
      "WebSearch",
      "WebFetch",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "mcp__Canva"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/herramientas/guardian.py\"",
            "timeout": 10,
            "statusMessage": "Guardián revisando..."
          }
        ]
      }
    ]
  }
}
